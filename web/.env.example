# Copy to .env.local for local development. Every variable is optional locally.

# --- Database (libSQL / SQLite via Drizzle) ---------------------------------
# Leave DATABASE_URL unset to use ./data/app.db (created from the committed
# ./data/seed.db snapshot on first run). On Vercel, set these to a Turso
# database so records persist and are shared by every visitor; without them
# the app copies seed.db to /tmp on cold start (writable but ephemeral).
DATABASE_URL=
# Only needed for remote libsql:// / https:// URLs (Turso auth token).
DATABASE_AUTH_TOKEN=

# --- Sessions -----------------------------------------------------------------
# Secret used to sign the httpOnly session cookies (HS256). Use 32+ random bytes,
# e.g. `openssl rand -base64 32`. If unset, development uses a fixed dev-only
# secret and production generates a random per-instance secret (sessions then
# reset whenever the server restarts).
SESSION_SECRET=

# --- Geocoding ----------------------------------------------------------------
# Contact string sent in the User-Agent to the free Photon / Nominatim services,
# as their usage policies ask. Defaults to the project's GitHub URL.
GEOCODER_CONTACT=
